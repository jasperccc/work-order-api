WORK_ORDER_APP_NAME="Work Order API"
WORK_ORDER_ENVIRONMENT=development

POSTGRES_DB=work_order
POSTGRES_USER=work_order
POSTGRES_PASSWORD=change_me

WORK_ORDER_DATABASE_URL=postgresql+asyncpg://work_order:change_me@127.0.0.1:5434/work_order

WORK_ORDER_JWT_SECRET_KEY=replace_with_a_secure_random_secret
WORK_ORDER_JWT_ALGORITHM=HS256
WORK_ORDER_ACCESS_TOKEN_EXPIRE_MINUTES=30
